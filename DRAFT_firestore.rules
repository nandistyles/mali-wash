rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // For admin role: check if the staff document exists and role is admin
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      // In this POS, any authenticated user who has a staff document is considered staff
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Helpers
    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'loyaltyPoints', 'membershipTier', 'referralCode', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && (!('vehicleReg' in data) || (data.vehicleReg is string && data.vehicleReg.size() <= 20))
        && (!('vehicleMakeModel' in data) || (data.vehicleMakeModel is string && data.vehicleMakeModel.size() <= 100))
        && data.loyaltyPoints is number
        && data.membershipTier in ['none', 'basic_member', 'premium_member']
        && (!('membershipExpiry' in data) || data.membershipExpiry is number)
        && data.referralCode is string && data.referralCode.size() <= 20
        && (!('referredByCode' in data) || data.referredByCode is string && data.referredByCode.size() <= 20)
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'serviceType', 'amount', 'paymentMethod', 'pointsEarned', 'pointsRedeemed', 'staffId', 'shiftId', 'status', 'createdAt'])
        && data.id is string
        && (!('customerId' in data) || data.customerId is string)
        && (!('customerPhone' in data) || data.customerPhone is string)
        && data.serviceType is string
        && data.amount is number
        && data.paymentMethod in ['cash_usd', 'ecocash', 'card']
        && data.pointsEarned is number
        && data.pointsRedeemed is number
        && data.staffId is string
        && data.shiftId is string
        && data.status in ['completed', 'voided']
        && data.createdAt is number;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'active'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.role in ['attendant', 'supervisor', 'admin']
        && data.active is bool
        && (!('pin' in data) || data.pin is string);
    }

    function isValidShift(data) {
      return data.keys().hasAll(['id', 'staffId', 'openedAt', 'openingFloat', 'expectedCash', 'expectedEcocash', 'expectedCard', 'status'])
        && data.id is string
        && data.staffId is string
        && data.openedAt is number
        && (!('closedAt' in data) || data.closedAt is number)
        && data.openingFloat is number
        && data.expectedCash is number
        && data.expectedEcocash is number
        && data.expectedCard is number
        && (!('countedCash' in data) || data.countedCash is number)
        && (!('variance' in data) || data.variance is number)
        && data.status in ['open', 'closed'];
    }

    function isValidReferralRedemption(data) {
      return data.keys().hasAll(['id', 'referrerId', 'refereeId', 'rewardPoints', 'createdAt'])
        && data.id is string
        && data.referrerId is string
        && data.refereeId is string
        && data.rewardPoints is number
        && data.createdAt is number;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'vehicle', 'serviceType', 'requestedTime', 'status', 'createdAt'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.vehicle is string && data.vehicle.size() <= 100
        && data.serviceType is string
        && data.requestedTime is number
        && data.status in ['pending', 'confirmed', 'done']
        && data.createdAt is number;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['id', 'pointsPerWash', 'referralRewardPoints'])
        && data.id is string
        && data.pointsPerWash is number
        && data.referralRewardPoints is number
        && (!('services' in data) || data.services is list);
    }


    match /customers/{customerId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isStaff() && isValidId(customerId) && isValidCustomer(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'phone', 'vehicleReg', 'vehicleMakeModel', 'loyaltyPoints', 'membershipTier', 'membershipExpiry', 'referralCode', 'referredByCode', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(customerId);
    }

    match /transactions/{transactionId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isStaff() && isValidId(transactionId) && isValidTransaction(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) // Only status can be updated (voided)
      );
      allow delete: if isAdmin() && isValidId(transactionId);
    }

    match /staff/{staffId} {
      allow get, list: if isStaff() || request.auth.uid == staffId;
      allow create: if (isAdmin() || request.auth.uid == staffId) && isValidId(staffId) && isValidStaff(incoming());
      allow update: if isAdmin() && isValidId(staffId) && isValidStaff(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'role', 'active', 'pin'])
      );
      allow delete: if isAdmin() && isValidId(staffId);
    }

    match /shifts/{shiftId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(shiftId) && isValidShift(incoming());
      allow update: if isStaff() && isValidId(shiftId) && isValidShift(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['closedAt', 'expectedCash', 'expectedEcocash', 'expectedCard', 'countedCash', 'variance', 'status'])
      );
      allow delete: if isAdmin() && isValidId(shiftId);
    }

    match /referralRedemptions/{redemptionId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(redemptionId) && isValidReferralRedemption(incoming());
      // No updates to redemptions
      allow delete: if isAdmin() && isValidId(redemptionId);
    }

    match /bookings/{bookingId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(bookingId) && isValidBooking(incoming());
      allow update: if isStaff() && isValidId(bookingId) && isValidBooking(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'requestedTime', 'vehicle', 'serviceType', 'name', 'phone'])
      );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    match /settings/{settingsId} {
      allow get, list: if isStaff();
      // Only admin can update settings
      allow create, update: if isAdmin() && isValidId(settingsId) && isValidSettings(incoming());
      allow delete: if false; // settings should not be deleted
    }
  }
}
