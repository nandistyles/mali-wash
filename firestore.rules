rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity
    //
    // A staff member's Firestore document id IS their Firebase Auth uid.
    // There is deliberately no self-service path to create a staff document:
    // the first admin must be created by hand in the Firebase console, and
    // every subsequent staff member is created by an existing admin. Any
    // signed-in Google account without a staff document has no access at all.
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    // Identity only. Grants access to the SHARED hub collections, which every
    // Mali business reads (customers, transactions, pointsLedger, referrals).
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().active == true;
    }

    // Authorisation for a specific business. Gates business-specific
    // collections and controls which business a staff member may book money
    // against. A supervisor may span several; an attendant usually one.
    function canOperate(business) {
      return isStaff() && (business in staffDoc().businesses);
    }

    function isAdmin() {
      return isStaff() && staffDoc().role == 'admin';
    }

    function staffCanOperate(uid, business) {
      return exists(/databases/$(database)/documents/staff/$(uid))
        && get(/databases/$(database)/documents/staff/$(uid)).data.active == true
        && (business in get(/databases/$(database)/documents/staff/$(uid)).data.businesses);
    }

    function isSupervisor() {
      return isStaff() && staffDoc().role in ['supervisor', 'admin'];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------------------------------------------------------------------
    // Shape validation
    // ---------------------------------------------------------------------

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'vehicles', 'pointsBalance', 'referralCode', 'tags', 'createdByBusiness', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.vehicles is list
        && data.pointsBalance is number
        && data.referralCode is string && data.referralCode.size() <= 20
        && (!('referredByCode' in data) || data.referredByCode == null || (data.referredByCode is string && data.referredByCode.size() <= 20))
        && data.tags is list
        && data.createdByBusiness in ['wash', 'parts', 'drive', 'track']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidWashMembership(data) {
      return data.keys().hasAll(['id', 'customerId', 'tier'])
        && data.id is string
        && data.customerId is string
        && data.tier in ['none', 'basic_member', 'premium_member']
        && (!('expiry' in data) || data.expiry == null || data.expiry is number);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'business', 'lineItems', 'amount', 'paymentMethod', 'pointsEarned', 'pointsRedeemed', 'staffId', 'status', 'createdAt', 'businessMeta'])
        && data.id is string
        && data.business in ['wash', 'parts', 'drive', 'track']
        && (!('customerId' in data) || data.customerId == null || data.customerId is string)
        && (!('customerPhone' in data) || data.customerPhone == null || data.customerPhone is string)
        && data.lineItems is list && data.lineItems.size() > 0 && data.lineItems.size() <= 50
        && data.amount is number && data.amount >= 0
        && data.paymentMethod in ['cash_usd', 'ecocash', 'card']
        && data.pointsEarned is number && data.pointsEarned >= 0
        && data.pointsRedeemed is number && data.pointsRedeemed >= 0
        && data.staffId is string
        && (!('shiftId' in data) || data.shiftId == null || data.shiftId is string)
        && data.status in ['completed', 'voided']
        && data.businessMeta is map
        && data.createdAt is number;
    }

    function isValidPointsLedgerEntry(data) {
      return data.keys().hasAll(['id', 'customerId', 'business', 'type', 'points', 'reason', 'createdAt'])
        && data.id is string
        && data.customerId is string
        && data.business in ['wash', 'parts', 'drive', 'track']
        && data.type in ['earn', 'redeem', 'referral_reward', 'adjustment']
        && data.points is number && data.points != 0
        && ((data.type in ['earn', 'referral_reward'] && data.points > 0)
          || (data.type == 'redeem' && data.points < 0)
          || (data.type == 'adjustment' && isSupervisor()))
        && ((data.type == 'adjustment' && (!('transactionId' in data) || data.transactionId == null || data.transactionId is string))
          || (data.transactionId is string && data.transactionId.size() > 0))
        && data.reason is string && data.reason.size() <= 255
        && data.createdAt is number;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'businesses', 'active'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.role in ['attendant', 'supervisor', 'admin']
        && data.businesses is list
        && data.active is bool
        && (!('pin' in data) || data.pin == null || data.pin is string);
    }

    function isValidShift(data) {
      return data.keys().hasAll(['id', 'staffId', 'openedAt', 'openingFloat', 'expectedCash', 'expectedEcocash', 'expectedCard', 'status'])
        && data.id is string
        && data.staffId is string
        && data.openedAt is number
        && (!('closedAt' in data) || data.closedAt == null || data.closedAt is number)
        && data.openingFloat is number
        && data.expectedCash is number
        && data.expectedEcocash is number
        && data.expectedCard is number
        && (!('countedCash' in data) || data.countedCash == null || data.countedCash is number)
        && (!('variance' in data) || data.variance == null || data.variance is number)
        && data.status in ['open', 'closed'];
    }

    function isValidReferralRedemption(data) {
      return data.keys().hasAll(['id', 'referrerId', 'refereeId', 'business', 'rewardPoints', 'createdAt'])
        && data.id is string
        && data.referrerId is string
        && data.refereeId is string
        && data.business in ['wash', 'parts', 'drive', 'track']
        && data.rewardPoints is number && data.rewardPoints > 0
        && data.createdAt is number;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'vehicle', 'serviceType', 'requestedTime', 'status', 'createdAt'])
        && data.id is string
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.vehicle is string && data.vehicle.size() <= 100
        && data.serviceType is string && data.serviceType.size() <= 50
        && data.requestedTime is number
        && data.status in ['pending', 'confirmed', 'done']
        && data.createdAt is number;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['id', 'pointsPerWash', 'referralRewardPoints', 'services', 'membershipPlans', 'pointsPerDollar', 'redemptionRate', 'minRedeemablePoints'])
        && data.id is string
        && data.services is list
        && data.membershipPlans is list
        && data.pointsPerWash is number && data.pointsPerWash >= 0
        && data.pointsPerDollar is number && data.pointsPerDollar >= 0
        && data.referralRewardPoints is number && data.referralRewardPoints >= 0
        && data.redemptionRate is number && data.redemptionRate > 0
        && data.minRedeemablePoints is number && data.minRedeemablePoints >= 0;
    }

    // ---------------------------------------------------------------------
    // Shared hub collections — readable by staff of ANY Mali business
    // ---------------------------------------------------------------------

    match /customers/{customerId} {
      allow get, list: if isStaff();
      allow create: if isStaff() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isStaff() && isValidId(customerId) && isValidCustomer(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'vehicles', 'pointsBalance', 'tags', 'referralCode', 'referredByCode', 'updatedAt'])
      );
      allow delete: if isAdmin() && isValidId(customerId);
    }

    match /transactions/{transactionId} {
      allow get, list: if isStaff();
      // You may only book money against a business you are assigned to.
      allow create: if canOperate(incoming().business) && isValidId(transactionId)
        && staffCanOperate(incoming().staffId, incoming().business)
        && incoming().status == 'completed' && isValidTransaction(incoming());
      // Voiding only — a completed sale is never silently rewritten.
      allow update: if canOperate(existing().business) && isSupervisor()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && existing().status == 'completed'
        && incoming().status == 'voided'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'businessMeta'])
        && incoming().businessMeta.diff(existing().businessMeta).affectedKeys().hasOnly(['voidReason', 'voidedAt'])
        && incoming().businessMeta.voidReason is string
        && incoming().businessMeta.voidReason.size() <= 255
        && incoming().businessMeta.voidedAt is number;
      allow delete: if false; // ledger integrity: void, never delete
    }

    match /pointsLedger/{entryId} {
      allow get, list: if isStaff();
      allow create: if canOperate(incoming().business) && isValidId(entryId) && isValidPointsLedgerEntry(incoming());
      allow update: if false; // append-only ledger
      allow delete: if false; // correct mistakes with an 'adjustment' entry
    }

    match /referralRedemptions/{redemptionId} {
      allow get, list: if isStaff();
      allow create: if canOperate(incoming().business)
        && redemptionId == 'referral_' + incoming().refereeId
        && isValidId(redemptionId) && isValidReferralRedemption(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isValidId(redemptionId);
    }

    match /staff/{staffId} {
      // A staff member can always read their own record (needed to resolve
      // their own role before any other rule can be evaluated).
      allow get: if isSignedIn() && request.auth.uid == staffId;
      allow list: if isStaff();
      // Staff creation is admin-only. The one-time founding-admin exception
      // was removed after the production administrator record was created.
      allow create: if isAdmin() && isValidId(staffId) && isValidStaff(incoming());
      allow update: if isAdmin() && isValidId(staffId) && isValidStaff(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'businesses', 'active', 'pin'])
      );
      allow delete: if isAdmin() && isValidId(staffId);
    }

    // ---------------------------------------------------------------------
    // Wash-specific collections
    // ---------------------------------------------------------------------

    match /washMemberships/{membershipId} {
      allow get, list: if isStaff();
      allow create: if canOperate('wash') && isValidId(membershipId) && isValidWashMembership(incoming());
      allow update: if canOperate('wash') && isValidId(membershipId) && isValidWashMembership(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['tier', 'expiry'])
      );
      allow delete: if isAdmin() && isValidId(membershipId);
    }

    match /shifts/{shiftId} {
      allow get, list: if canOperate('wash');
      allow create: if canOperate('wash') && isValidId(shiftId) && isValidShift(incoming());
      allow update: if canOperate('wash') && isValidId(shiftId) && isValidShift(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['closedAt', 'expectedCash', 'expectedEcocash', 'expectedCard', 'countedCash', 'variance', 'status'])
      );
      allow delete: if isAdmin() && isValidId(shiftId);
    }

    match /cashSessions/{sessionId} {
      allow get, list: if isStaff();
      allow create: if isValidId(sessionId)
        && incoming().id == sessionId
        && incoming().business in ['parts', 'drive', 'track']
        && canOperate(incoming().business)
        && staffCanOperate(incoming().staffId, incoming().business)
        && incoming().openedAt is number
        && incoming().openingFloat is number && incoming().openingFloat >= 0
        && incoming().status in ['open', 'closed'];
      allow update: if canOperate(existing().business)
        && incoming().business == existing().business
        && incoming().staffId == existing().staffId
        && incoming().openedAt == existing().openedAt
        && incoming().openingFloat == existing().openingFloat
        && existing().status == 'open' && incoming().status == 'closed'
        && incoming().closedAt is number
        && incoming().countedCash is number && incoming().countedCash >= 0
        && incoming().variance is number;
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get, list: if canOperate('wash');
      // The public booking form at /book is unauthenticated by design, so this
      // is the one anonymous write in the whole database. It is narrowed hard:
      // create only, never read, and the status is pinned to 'pending' so a
      // stranger cannot self-confirm. Turn on Firebase App Check before this
      // goes live — validation stops malformed writes, not a spam script.
      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'pending';
      allow update: if canOperate('wash') && isValidId(bookingId) && isValidBooking(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'requestedTime', 'vehicle', 'serviceType', 'name', 'phone'])
      );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    match /settings/{settingsId} {
      // The public form may fetch the one global price list by its exact id.
      // Collection listing and all writes remain restricted.
      allow get: if isStaff() || settingsId == 'global';
      allow list: if isStaff();
      allow create, update: if isAdmin() && isValidId(settingsId) && isValidSettings(incoming());
      allow delete: if false;
    }

    // Parts, Drive and Track operational spokes. Customer-facing money from
    // these collections is still recorded in the shared transaction ledger.
    match /inventoryItems/{itemId} {
      allow get, list: if isStaff();
      allow create, update: if isValidId(itemId)
        && incoming().business in ['parts', 'drive']
        && canOperate(incoming().business)
        && incoming().id == itemId
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150
        && incoming().sku is string && incoming().sku.size() > 0 && incoming().sku.size() <= 50
        && incoming().category is string && incoming().category.size() <= 100
        && incoming().stockQty is number && incoming().stockQty >= 0
        && incoming().sellPrice is number && incoming().sellPrice >= 0
        && incoming().costPrice is number && incoming().costPrice >= 0
        && incoming().reorderLevel is number && incoming().reorderLevel >= 0
        && incoming().active is bool
        && incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow get, list: if isStaff();
      allow create: if isValidId(movementId)
        && incoming().id == movementId
        && incoming().business in ['parts', 'drive']
        && canOperate(incoming().business)
        && incoming().itemId is string
        && incoming().type in ['sale', 'receive', 'adjustment', 'return', 'void']
        && incoming().qtyDelta is number && incoming().qtyDelta != 0
        && incoming().reason is string && incoming().reason.size() > 0 && incoming().reason.size() <= 255
        && staffCanOperate(incoming().staffId, incoming().business)
        && incoming().createdAt is number;
      allow update, delete: if false;
    }

    match /fitmentJobs/{jobId} {
      allow get, list: if canOperate('drive');
      allow create, update: if canOperate('drive') && isValidId(jobId)
        && incoming().id == jobId
        && incoming().status in ['booked', 'in_progress', 'completed', 'cancelled']
        && incoming().customerName is string && incoming().customerName.size() <= 100
        && incoming().phone is string && incoming().phone.size() <= 20
        && incoming().vehicleReg is string && incoming().vehicleReg.size() > 0 && incoming().vehicleReg.size() <= 30
        && incoming().description is string && incoming().description.size() > 0 && incoming().description.size() <= 255
        && incoming().quotedAmount is number && incoming().quotedAmount >= 0
        && incoming().scheduledAt is number && incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    match /trackingDevices/{deviceId} {
      allow get, list: if canOperate('track');
      allow create, update: if canOperate('track') && isValidId(deviceId)
        && incoming().id == deviceId
        && incoming().status in ['in_stock', 'assigned', 'installed', 'faulty']
        && incoming().serialNumber is string && incoming().serialNumber.size() > 0 && incoming().serialNumber.size() <= 80
        && incoming().imei is string && incoming().imei.matches('^[0-9]{14,16}$')
        && incoming().model is string && incoming().model.size() > 0 && incoming().model.size() <= 100
        && incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    match /trackingSubscriptions/{subscriptionId} {
      allow get, list: if canOperate('track');
      allow create, update: if canOperate('track') && isValidId(subscriptionId)
        && incoming().id == subscriptionId
        && incoming().status in ['active', 'past_due', 'suspended', 'cancelled']
        && incoming().customerId is string && incoming().deviceId is string
        && incoming().vehicleReg is string && incoming().vehicleReg.size() > 0
        && incoming().planName is string && incoming().planName.size() > 0
        && incoming().monthlyFee is number && incoming().monthlyFee > 0
        && incoming().startedAt is number && incoming().renewalAt is number
        && incoming().updatedAt is number;
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied by default. There is deliberately
    // no `match /{document=**}` catch-all here: Firestore ORs all matching
    // rules together, so a catch-all can only ever widen access, never
    // restrict it. The `allow ... if false` version that used to sit at the
    // top of this file gave a false sense of a deny-by-default backstop.
  }
}
