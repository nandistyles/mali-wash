# Copy to .env.local and fill in. .env* is gitignored except this file.

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Adds a "Continue as Dev Admin" button to the login screen that signs you in
# as a local admin with no Firebase round-trip, so you can work on the app
# without a configured Firebase project or a seeded staff record.
#
# This is gated on Vite's DEV flag as well as this variable. `import.meta.env.DEV`
# is statically false in a production build, so the button and the seeded admin
# are dropped at build time — setting this to true in a deployed environment
# does nothing.
VITE_DEV_LOGIN=true

# ---------------------------------------------------------------------------
# Firebase
# ---------------------------------------------------------------------------
# Point these at the Mali-owned Firebase project. There is no bundled fallback;
# without them the application stays local-only and public booking is disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required for public booking. Create a reCAPTCHA Enterprise provider under
# Firebase Console -> App Check, then enable Firestore enforcement after
# deploying a build that contains this key.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# This project uses a NAMED Firestore database, not the default one. Leave blank
# to use "(default)" when the variables above are set. Getting this wrong reads
# and writes an empty database with no error.
VITE_FIREBASE_DATABASE_ID=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API
# ---------------------------------------------------------------------------
# Optional. When unset, whatsapp.ts logs the intended message and does not throw.
VITE_WHATSAPP_API_TOKEN=
VITE_WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# AI Studio leftovers — injected automatically when hosted there.
# ---------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
